# URL of the closure HTTP API
CLOSURE_API_URL=
# Bot API admin bearer token
CLOSURE_ADMIN_TOKEN=
# Random HMAC secret used to sign sessions
SESSION_SECRET=
# Discord application OAuth2 client ID
DISCORD_CLIENT_ID=
# Discord application OAuth2 client secret
DISCORD_CLIENT_SECRET=
# OAuth2 callback URL registered with Discord
DISCORD_REDIRECT_URI=
# Optional Discord user ID; only used by the development server
DASHBOARD_DEV_USER_ID=
